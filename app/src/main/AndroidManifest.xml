<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Only needed by the optional "lockdown" step, which clears
        development_settings_enabled / adb_enabled when an action turns off.
        Granted once with:
          pm grant com.ymopuri.qsactions android.permission.WRITE_SECURE_SETTINGS
        which works because the permission carries the "development" protection
        flag. The app is fully functional without it.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QsActions">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            One <service> per action. Ships disabled so the Quick Settings editor
            isn't cluttered with a tile that can't do anything; TileEnabler flips
            it on once the action is configured.
        -->
        <service
            android:name=".tile.ShizukuTileService"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_tile_shizuku"
            android:label="@string/shizuku_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Required by the Shizuku API so the server can hand us its binder. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
